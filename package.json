{
  "name": "dockslot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @dockslot/api\" \"npm run dev -w @dockslot/web\"",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @dockslot/api",
    "db:seed": "npm run db:seed -w @dockslot/api",
    "db:reset": "npm run db:reset -w @dockslot/api",
    "test": "npm run test -w @dockslot/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node scripts/demo-scenario.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
